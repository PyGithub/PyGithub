    "Team": {
      "bases": [
        "CompletableGithubObject"
      ],
      "docstring": "This class represents Teams.\n\n    The reference can be found here\n    https://docs.github.com/en/rest/reference/teams\n\n    The OpenAPI schema can be found at\n\n    - /components/schemas/enterprise-team\n    - /components/schemas/nullable-team-simple\n    - /components/schemas/team\n    - /components/schemas/team-full\n    - /components/schemas/team-simple",
      "filename": "github/Team.py",
      "ids": [
        "id",
        "name"
      ],
      "inheritance": [
        "ABC",
        "CompletableGithubObject",
        "GithubObject"
      ],
      "inherited_schemas": [],
      "methods": {
        "add_membership": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/memberships/{username}",
            "verb": "PUT"
          },
          "name": "add_membership",
          "returns": [
            "None"
          ]
        },
        "add_to_members": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/members/{username}",
            "verb": "PUT"
          },
          "name": "add_to_members",
          "returns": [
            "None"
          ]
        },
        "add_to_repos": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/repos/{owner}/{repo}",
            "verb": "PUT"
          },
          "name": "add_to_repos",
          "returns": [
            "None"
          ]
        },
        "delete": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#delete-a-team>`_",
            "path": "/teams/{team_id}",
            "verb": "DELETE"
          },
          "name": "delete",
          "returns": [
            "None"
          ]
        },
        "edit": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#update-a-team>`_",
            "path": "/teams/{team_id}",
            "verb": "PATCH"
          },
          "name": "edit",
          "returns": [
            "None"
          ]
        },
        "get_discussions": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#list-discussions>`_",
            "path": "/teams/{team_id}/discussions",
            "verb": "GET"
          },
          "name": "get_discussions",
          "returns": [
            "PaginatedList[TeamDiscussion]"
          ]
        },
        "get_members": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#list-team-members>`_",
            "path": "/teams/{team_id}/members",
            "verb": "GET"
          },
          "name": "get_members",
          "returns": [
            "PaginatedList[NamedUser]"
          ]
        },
        "get_repo_permission": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/repos/{owner}/{repo}#permissions",
            "verb": "GET"
          },
          "name": "get_repo_permission",
          "returns": [
            "Permissions",
            "None"
          ]
        },
        "get_repos": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/repos",
            "verb": "GET"
          },
          "name": "get_repos",
          "returns": [
            "PaginatedList[Repository]"
          ]
        },
        "get_team_membership": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#get-team-membership-for-a-user>`_",
            "path": "/orgs/{org}/teams/{team_slug}/memberships/{username}",
            "verb": "GET"
          },
          "name": "get_team_membership",
          "returns": [
            "Membership"
          ]
        },
        "get_teams": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#list-teams>`_",
            "path": "/teams/{team_id}/teams",
            "verb": "GET"
          },
          "name": "get_teams",
          "returns": [
            "PaginatedList[Team]"
          ]
        },
        "has_in_members": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/members/{username}",
            "verb": "GET"
          },
          "name": "has_in_members",
          "returns": [
            "bool"
          ]
        },
        "has_in_repos": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/repos/{owner}/{repo}",
            "verb": "GET"
          },
          "name": "has_in_repos",
          "returns": [
            "bool"
          ]
        },
        "invitations": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#members>`_",
            "path": "/teams/{team_id}/invitations",
            "verb": "GET"
          },
          "name": "invitations",
          "returns": [
            "PaginatedList[OrganizationInvitation]"
          ]
        },
        "remove_from_members": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/members/{username}",
            "verb": "DELETE"
          },
          "name": "remove_from_members",
          "returns": [
            "None"
          ]
        },
        "remove_from_repos": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/repos/{owner}/{repo}",
            "verb": "DELETE"
          },
          "name": "remove_from_repos",
          "returns": [
            "None"
          ]
        },
        "remove_membership": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#remove-team-membership-for-a-user>`_",
            "path": "/teams/{team_id}/memberships/{username}",
            "verb": "DELETE"
          },
          "name": "remove_membership",
          "returns": [
            "None"
          ]
        },
        "set_repo_permission": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams>`_",
            "path": "/teams/{team_id}/repos/{owner}/{repo}",
            "verb": "PUT"
          },
          "name": "set_repo_permission",
          "returns": [
            "None"
          ]
        },
        "update_team_repository": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/teams#check-team-permissions-for-a-repository>`_",
            "path": "/orgs/{org}/teams/{team_slug}/repos/{owner}/{repo}",
            "verb": "PUT"
          },
          "name": "update_team_repository",
          "returns": [
            "bool"
          ]
        }
      },
