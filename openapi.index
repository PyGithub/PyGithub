    "GithubRetry": {
      "bases": [
        "Retry"
      ],
      "docstring": "A Github-specific implementation of `urllib3.Retry`\n\n    This retries 403 responses if they are retry-able. Github requests are retry-able when\n    the response provides a `\"Retry-After\"` header, or the content indicates a rate limit error.\n\n    By default, response codes 403, and 500 up to 599 are retried. This can be configured\n    via the `status_forcelist` argument.\n\n    By default, all methods defined in `Retry.DEFAULT_ALLOWED_METHODS` are retried, plus GET and POST.\n    This can be configured via the `allowed_methods` argument.",
      "filename": "github/GithubRetry.py",
      "ids": [],
      "inheritance": [
        "Retry"
      ],
      "inherited_schemas": [],
      "methods": {},
      "module": "GithubRetry",
      "name": "GithubRetry",
      "package": "github",
      "properties": {},
      "schemas": [],
      "test_filename": "tests/GithubRetry.py"
    },
