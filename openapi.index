    "GithubIntegration": {
      "bases": [],
      "docstring": "Main class to obtain tokens for a GitHub integration.",
      "filename": "github/GithubIntegration.py",
      "ids": [],
      "inheritance": [],
      "inherited_schemas": [],
      "methods": {
        "get_access_token": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/apps/apps#create-an-installation-access-token-for-an-app>",
            "path": "/app/installations/{installation_id}/access_tokens",
            "verb": "POST"
          },
          "name": "get_access_token",
          "returns": [
            "InstallationAuthorization"
          ]
        },
        "get_app": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/apps#get-the-authenticated-app>`_",
            "path": "/app",
            "verb": "GET"
          },
          "name": "get_app",
          "returns": [
            "GithubApp"
          ]
        },
        "get_app_installation": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/apps/apps#get-an-installation-for-the-authenticated-app>",
            "path": "/app/installations/{installation_id}",
            "verb": "GET"
          },
          "name": "get_app_installation",
          "returns": [
            "Installation"
          ]
        },
        "get_installation": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/apps#get-a-repository-",
            "path": "/repos/{owner}/{repo}/installation",
            "verb": "GET"
          },
          "name": "get_installation",
          "returns": [
            "Installation"
          ]
        },
        "get_installations": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/apps#list-installations-for-the-authenticated-app>",
            "path": "/app/installations",
            "verb": "GET"
          },
          "name": "get_installations",
          "returns": [
            "PaginatedList[Installation]"
          ]
        },
        "get_org_installation": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/apps/apps#get-an-organization-installation-for-the-authenticated-app>",
            "path": "/orgs/{org}/installation",
            "verb": "GET"
          },
          "name": "get_org_installation",
          "returns": [
            "Installation"
          ]
        },
        "get_repo_installation": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/reference/apps#get-a-repository-installation-for-the-authenticated-app>",
            "path": "/repos/{owner}/{repo}/installation",
            "verb": "GET"
          },
          "name": "get_repo_installation",
          "returns": [
            "Installation"
          ]
        },
        "get_user_installation": {
          "call": {
            "docs": "<https://docs.github.com/en/rest/apps/apps#get-a-user-installation-for-the-authenticated-app>",
            "path": "/users/{username}/installation",
            "verb": "GET"
          },
          "name": "get_user_installation",
          "returns": [
            "Installation"
          ]
        }
      },
