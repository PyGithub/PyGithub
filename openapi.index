    "path_to_call_methods": {
      "/advisories": {
        "get": [
          "Github.get_global_advisories"
        ]
      },
      "/advisories/{ghsa_id}": {
        "get": [
          "Github.get_global_advisory"
        ]
      },
      "/app": {
        "get": [
          "GithubIntegration.get_app"
        ]
      },
      "/app/installations": {
        "get": [
          "GithubIntegration.get_installations"
        ]
      },
      "/app/installations/{installation_id}": {
        "get": [
          "GithubIntegration.get_app_installation"
        ]
      },
      "/app/installations/{installation_id}/access_tokens": {
        "post": [
          "GithubIntegration.get_access_token"
        ]
      },
      "/apps/{app_slug}": {
        "get": [
          "Github.get_app"
        ]
      },
      "/authorizations": {
        "get": [
          "AuthenticatedUser.get_authorizations"
        ],
        "post": [
          "AuthenticatedUser.create_authorization"
        ]
      },
      "/authorizations/{id}": {
        "delete": [
          "Authorization.delete"
        ],
        "get": [
          "AuthenticatedUser.get_authorization"
        ],
        "patch": [
          "Authorization.edit"
        ]
      },
      "/emojis": {
        "get": [
          "Github.get_emojis"
        ]
      },
      "/enterprises/{enterprise}": {
        "get": [
          "Github.get_enterprise"
        ]
      },
      "/enterprises/{enterprise}/consumed-licenses": {
        "get": [
          "Enterprise.get_consumed_licenses",
          "EnterpriseConsumedLicenses.get_users"
        ]
      },
      "/events": {
        "get": [
          "AuthenticatedUser.get_events",
          "Github.get_events"
        ]
      },
      "/gists": {
        "get": [
          "AuthenticatedUser.get_gists"
        ],
        "post": [
          "AuthenticatedUser.create_gist"
        ]
      },
      "/gists/public": {
        "get": [
          "Github.get_gists"
        ]
      },
      "/gists/starred": {
        "get": [
          "AuthenticatedUser.get_starred_gists"
        ]
      },
      "/gists/{gist_id}": {
        "delete": [
          "Gist.delete"
        ],
        "get": [
          "Github.get_gist"
        ],
        "patch": [
          "Gist.edit"
        ]
      },
      "/gists/{gist_id}/comments": {
        "get": [
          "Gist.get_comments"
        ],
        "post": [
          "Gist.create_comment"
        ]
      },
      "/gists/{gist_id}/comments/{comment_id}": {
        "delete": [
          "GistComment.delete"
        ],
        "get": [
          "Gist.get_comment"
        ],
        "patch": [
          "GistComment.edit"
        ]
      },
      "/gists/{gist_id}/forks": {
        "post": [
          "Gist.create_fork"
        ]
      },
      "/gists/{gist_id}/star": {
        "delete": [
          "Gist.reset_starred"
        ],
        "get": [
          "Gist.is_starred"
        ],
        "put": [
          "Gist.set_starred"
        ]
      },
      "/gitignore/templates": {
        "get": [
          "Github.get_gitignore_templates"
        ]
      },
      "/gitignore/templates/{name}": {
        "get": [
          "Github.get_gitignore_template"
        ]
      },
      "/graphql": {
        "post": [
          "IssueComment.minimize",
          "IssueComment.unminimize",
          "PullRequest.convert_to_draft",
          "PullRequest.disable_automerge",
          "PullRequest.enable_automerge",
          "PullRequest.mark_ready_for_review"
        ]
      },
      "/hooks": {
        "get": [
          "Github.get_hooks"
        ]
      },
      "/hooks/{hook_id}/deliveries": {
        "get": [
          "Github.get_hook_deliveries"
        ]
      },
      "/hooks/{hook_id}/deliveries/{delivery_id}": {
        "get": [
          "Github.get_hook_delivery"
        ]
      },
      "/hooks/{name}": {
        "get": [
          "Github.get_hook"
        ]
      },
      "/hub": {
        "post": [
          "Repository.subscribe_to_hub",
          "Repository.unsubscribe_from_hub"
        ]
      },
      "/installation/repositories": {
        "get": [
          "Installation.get_repos"
        ]
      },
      "/issues": {
        "get": [
          "AuthenticatedUser.get_issues"
        ]
      },
